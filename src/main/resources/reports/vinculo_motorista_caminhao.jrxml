<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="Relatório – Vínculo Motorista x Caminhão" language="java"
              whenNoDataType="AllSectionsNoDetail"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="logoPath" class="java.net.URL"/>

    <parameter name="geradoEm" class="java.time.LocalDate"/>
    <parameter name="totalMotoristasAtivos" class="java.lang.Long"/>
    <parameter name="totalCaminhoesAtivos" class="java.lang.Long"/>
    <parameter name="totalComVinculo" class="java.lang.Long"/>
    <parameter name="totalMotoristasSemCaminhao" class="java.lang.Long"/>
    <parameter name="totalCaminhoesSemMotorista" class="java.lang.Long"/>

    <field name="tipo" class="java.lang.String"/>
    <field name="codigoMotorista" class="java.lang.String"/>
    <field name="nomeMotorista" class="java.lang.String"/>
    <field name="codigoCaminhao" class="java.lang.String"/>
    <field name="placaCaminhao" class="java.lang.String"/>
    <field name="observacao" class="java.lang.String"/>

    <group name="grupoTipo">
        <expression><![CDATA[$F{tipo}]]></expression>
        <groupHeader>
            <band height="24">
                <element kind="staticText" mode="Opaque" x="0" y="2" width="802" height="20"
                         forecolor="#FFFFFF" backcolor="#059669" bold="true" hTextAlign="Center" vTextAlign="Middle">
                    <printWhenExpression><![CDATA[$F{tipo}.equals("MOTORISTA_COM_CAMINHAO")]]></printWhenExpression>
                    <text><![CDATA[MOTORISTAS COM CAMINHÃO VINCULADO]]></text>
                </element>
                <element kind="staticText" mode="Opaque" x="0" y="2" width="802" height="20"
                         forecolor="#FFFFFF" backcolor="#D97706" bold="true" hTextAlign="Center" vTextAlign="Middle">
                    <printWhenExpression><![CDATA[$F{tipo}.equals("MOTORISTA_SEM_CAMINHAO")]]></printWhenExpression>
                    <text><![CDATA[MOTORISTAS SEM CAMINHÃO VINCULADO]]></text>
                </element>
                <element kind="staticText" mode="Opaque" x="0" y="2" width="802" height="20"
                         forecolor="#FFFFFF" backcolor="#2563EB" bold="true" hTextAlign="Center" vTextAlign="Middle">
                    <printWhenExpression><![CDATA[$F{tipo}.equals("CAMINHAO_SEM_MOTORISTA")]]></printWhenExpression>
                    <text><![CDATA[CAMINHÕES SEM MOTORISTA VINCULADO]]></text>
                </element>
            </band>
        </groupHeader>
    </group>

    <title height="132">

        <element kind="image" x="10" y="5" width="120" height="50" scaleImage="RetainShape" onErrorType="Blank">
            <expression><![CDATA[$P{logoPath}]]></expression>
        </element>

        <element kind="staticText" x="140" y="6" width="520" height="20" fontSize="14" bold="true">
            <text><![CDATA[RELATÓRIO – VÍNCULO MOTORISTA x CAMINHÃO]]></text>
        </element>

        <element kind="textField" x="140" y="30" width="520" height="16">
            <expression><![CDATA["Motoristas ativos: " + $P{totalMotoristasAtivos} + "   |   Caminhões ativos: " + $P{totalCaminhoesAtivos}]]></expression>
        </element>

        <element kind="textField" x="640" y="12" width="180" height="16" hTextAlign="Right">
            <expression><![CDATA["Gerado em: " + $P{geradoEm}]]></expression>
        </element>

        <element kind="staticText" mode="Opaque" x="0" y="60" width="258" height="22"
                 forecolor="#FFFFFF" backcolor="#059669" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[COM CAMINHÃO VINCULADO]]></text>
        </element>
        <element kind="textField" mode="Opaque" x="0" y="82" width="258" height="22"
                 forecolor="#065F46" backcolor="#D1FAE5" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <expression><![CDATA[$P{totalComVinculo}]]></expression>
        </element>

        <element kind="staticText" mode="Opaque" x="272" y="60" width="258" height="22"
                 forecolor="#FFFFFF" backcolor="#D97706" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[MOTORISTAS SEM CAMINHÃO]]></text>
        </element>
        <element kind="textField" mode="Opaque" x="272" y="82" width="258" height="22"
                 forecolor="#92400E" backcolor="#FEF3C7" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <expression><![CDATA[$P{totalMotoristasSemCaminhao}]]></expression>
        </element>

        <element kind="staticText" mode="Opaque" x="544" y="60" width="258" height="22"
                 forecolor="#FFFFFF" backcolor="#2563EB" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[CAMINHÕES SEM MOTORISTA]]></text>
        </element>
        <element kind="textField" mode="Opaque" x="544" y="82" width="258" height="22"
                 forecolor="#1E40AF" backcolor="#DBEAFE" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <expression><![CDATA[$P{totalCaminhoesSemMotorista}]]></expression>
        </element>

    </title>

    <columnHeader height="24">
        <element kind="staticText" mode="Opaque" x="0" y="3" width="90" height="18"
                 forecolor="#FFFFFF" backcolor="#334155" bold="true" hTextAlign="Center">
            <text><![CDATA[CÓDIGO]]></text>
        </element>
        <element kind="staticText" mode="Opaque" x="90" y="3" width="260" height="18"
                 forecolor="#FFFFFF" backcolor="#334155" bold="true" hTextAlign="Center">
            <text><![CDATA[MOTORISTA]]></text>
        </element>
        <element kind="staticText" mode="Opaque" x="350" y="3" width="110" height="18"
                 forecolor="#FFFFFF" backcolor="#334155" bold="true" hTextAlign="Center">
            <text><![CDATA[CÓD. CAMINHÃO]]></text>
        </element>
        <element kind="staticText" mode="Opaque" x="460" y="3" width="100" height="18"
                 forecolor="#FFFFFF" backcolor="#334155" bold="true" hTextAlign="Center">
            <text><![CDATA[PLACA]]></text>
        </element>
        <element kind="staticText" mode="Opaque" x="560" y="3" width="242" height="18"
                 forecolor="#FFFFFF" backcolor="#334155" bold="true" hTextAlign="Center">
            <text><![CDATA[OBSERVAÇÃO]]></text>
        </element>
    </columnHeader>

    <detail>
        <band height="18">
            <element kind="textField" x="0" y="1" width="90" height="15" blankWhenNull="true" hTextAlign="Center">
                <expression><![CDATA[$F{codigoMotorista}]]></expression>
            </element>
            <element kind="textField" x="90" y="1" width="260" height="15" blankWhenNull="true">
                <expression><![CDATA[$F{nomeMotorista}]]></expression>
            </element>
            <element kind="textField" x="350" y="1" width="110" height="15" blankWhenNull="true" hTextAlign="Center">
                <expression><![CDATA[$F{codigoCaminhao}]]></expression>
            </element>
            <element kind="textField" x="460" y="1" width="100" height="15" blankWhenNull="true" hTextAlign="Center">
                <expression><![CDATA[$F{placaCaminhao}]]></expression>
            </element>
            <element kind="textField" x="560" y="1" width="242" height="15" blankWhenNull="true" italic="true" forecolor="#6B7280">
                <expression><![CDATA[$F{observacao}]]></expression>
            </element>
        </band>
    </detail>

    <pageFooter height="24">
        <element kind="textField" x="0" y="6" width="300" height="15">
            <expression><![CDATA["Emitido em: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></expression>
        </element>
        <element kind="textField" x="700" y="6" width="102" height="15" hTextAlign="Right">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>

</jasperReport>
