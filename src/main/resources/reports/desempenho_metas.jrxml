<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="Relatório - Desempenho de Metas" language="java"
              whenNoDataType="AllSectionsNoDetail"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <style name="StatusStyle" mode="Opaque" forecolor="#991B1B" backcolor="#FEE2E2" bold="true">
        <conditionalStyle>
            <conditionExpression><![CDATA[Boolean.TRUE.equals($F{metaAtingida})]]></conditionExpression>
            <style mode="Opaque" forecolor="#166534" backcolor="#DCFCE7" bold="true"/>
        </conditionalStyle>
    </style>

    <parameter name="logoPath" class="java.lang.Object"/>
    <parameter name="periodoInicio" class="java.time.LocalDate"/>
    <parameter name="periodoFim" class="java.time.LocalDate"/>
    <parameter name="tipoMeta" class="java.lang.String"/>
    <parameter name="filtroCaminhao" class="java.lang.String"/>
    <parameter name="filtroMotorista" class="java.lang.String"/>
    <parameter name="filtroCategoria" class="java.lang.String"/>
    <parameter name="totalLinhas" class="java.lang.Long"/>
    <parameter name="totalDentroMeta" class="java.lang.Long"/>
    <parameter name="totalForaMeta" class="java.lang.Long"/>
    <parameter name="percentualSucesso" class="java.math.BigDecimal"/>

    <field name="alvoTipo" class="java.lang.String"/>
    <field name="origemMeta" class="java.lang.String"/>
    <field name="origemMetaDescricao" class="java.lang.String"/>
    <field name="tipoMeta" class="br.com.frotasPro.api.domain.enums.TipoMeta"/>
    <field name="caminhaoCodigo" class="java.lang.String"/>
    <field name="motoristaCodigo" class="java.lang.String"/>
    <field name="categoriaCodigo" class="java.lang.String"/>
    <field name="regraAtingimentoTexto" class="java.lang.String"/>
    <field name="valorMeta" class="java.math.BigDecimal"/>
    <field name="valorRealizado" class="java.math.BigDecimal"/>
    <field name="percentual" class="java.math.BigDecimal"/>
    <field name="unidade" class="java.lang.String"/>
    <field name="metaAtingida" class="java.lang.Boolean"/>
    <field name="status" class="java.lang.String"/>

    <title height="140">
        <element kind="image" x="10" y="5" width="120" height="50" onErrorType="Blank">
            <expression><![CDATA[$P{logoPath}]]></expression>
        </element>

        <element kind="staticText" x="140" y="6" width="520" height="20" fontSize="14" bold="true">
            <text><![CDATA[RELATÓRIO DE DESEMPENHO DE METAS]]></text>
        </element>
        <element kind="textField" x="140" y="30" width="520" height="16">
            <expression><![CDATA["Período: " + $P{periodoInicio} + " até " + $P{periodoFim}]]></expression>
        </element>
        <element kind="textField" x="140" y="48" width="520" height="16">
            <expression><![CDATA["Tipo: " + $P{tipoMeta} + " | Caminhão: " + $P{filtroCaminhao} + " | Motorista: " + $P{filtroMotorista} + " | Categoria: " + $P{filtroCategoria}]]></expression>
        </element>

        <element kind="staticText" mode="Opaque" x="0" y="86" width="188" height="22" forecolor="#FFFFFF" backcolor="#334155" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[ITENS AVALIADOS]]></text>
        </element>
        <element kind="textField" mode="Opaque" x="0" y="108" width="188" height="20" forecolor="#111827" backcolor="#E5E7EB" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <expression><![CDATA[$P{totalLinhas}]]></expression>
        </element>
        <element kind="staticText" mode="Opaque" x="204" y="86" width="188" height="22" forecolor="#FFFFFF" backcolor="#15803D" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[BATERAM META]]></text>
        </element>
        <element kind="textField" mode="Opaque" x="204" y="108" width="188" height="20" forecolor="#166534" backcolor="#DCFCE7" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <expression><![CDATA[$P{totalDentroMeta}]]></expression>
        </element>
        <element kind="staticText" mode="Opaque" x="408" y="86" width="188" height="22" forecolor="#FFFFFF" backcolor="#B91C1C" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[NÃO BATERAM]]></text>
        </element>
        <element kind="textField" mode="Opaque" x="408" y="108" width="188" height="20" forecolor="#991B1B" backcolor="#FEE2E2" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <expression><![CDATA[$P{totalForaMeta}]]></expression>
        </element>
        <element kind="staticText" mode="Opaque" x="612" y="86" width="190" height="22" forecolor="#FFFFFF" backcolor="#0369A1" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[% SUCESSO]]></text>
        </element>
        <element kind="textField" mode="Opaque" x="612" y="108" width="190" height="20" forecolor="#0C4A6E" backcolor="#E0F2FE" bold="true" hTextAlign="Center" vTextAlign="Middle" pattern="#,##0.00">
            <expression><![CDATA[$P{percentualSucesso}]]></expression>
        </element>
    </title>

    <columnHeader height="30">
        <element kind="staticText" mode="Opaque" x="0" y="5" width="70" height="20" forecolor="#FFFFFF" backcolor="#334155" bold="true" hTextAlign="Center"><text><![CDATA[ALVO]]></text></element>
        <element kind="staticText" mode="Opaque" x="70" y="5" width="80" height="20" forecolor="#FFFFFF" backcolor="#334155" bold="true" hTextAlign="Center"><text><![CDATA[CÓDIGO]]></text></element>
        <element kind="staticText" mode="Opaque" x="150" y="5" width="90" height="20" forecolor="#FFFFFF" backcolor="#334155" bold="true" hTextAlign="Center"><text><![CDATA[ORIGEM]]></text></element>
        <element kind="staticText" mode="Opaque" x="240" y="5" width="105" height="20" forecolor="#FFFFFF" backcolor="#334155" bold="true" hTextAlign="Center"><text><![CDATA[CATEGORIA]]></text></element>
        <element kind="staticText" mode="Opaque" x="345" y="5" width="110" height="20" forecolor="#FFFFFF" backcolor="#334155" bold="true" hTextAlign="Center"><text><![CDATA[TIPO]]></text></element>
        <element kind="staticText" mode="Opaque" x="455" y="5" width="75" height="20" forecolor="#FFFFFF" backcolor="#334155" bold="true" hTextAlign="Center"><text><![CDATA[META]]></text></element>
        <element kind="staticText" mode="Opaque" x="530" y="5" width="85" height="20" forecolor="#FFFFFF" backcolor="#334155" bold="true" hTextAlign="Center"><text><![CDATA[REALIZADO]]></text></element>
        <element kind="staticText" mode="Opaque" x="615" y="5" width="62" height="20" forecolor="#FFFFFF" backcolor="#334155" bold="true" hTextAlign="Center"><text><![CDATA[%]]></text></element>
        <element kind="staticText" mode="Opaque" x="677" y="5" width="125" height="20" forecolor="#FFFFFF" backcolor="#334155" bold="true" hTextAlign="Center"><text><![CDATA[STATUS]]></text></element>
    </columnHeader>

    <detail>
        <band height="20">
            <element kind="textField" x="0" y="2" width="70" height="16"><expression><![CDATA[$F{alvoTipo}]]></expression></element>
            <element kind="textField" x="70" y="2" width="80" height="16"><expression><![CDATA[$F{caminhaoCodigo} != null ? $F{caminhaoCodigo} : $F{motoristaCodigo}]]></expression></element>
            <element kind="textField" x="150" y="2" width="90" height="16"><expression><![CDATA[$F{origemMeta}]]></expression></element>
            <element kind="textField" x="240" y="2" width="105" height="16" blankWhenNull="true"><expression><![CDATA[$F{categoriaCodigo}]]></expression></element>
            <element kind="textField" x="345" y="2" width="110" height="16"><expression><![CDATA[$F{tipoMeta} == null ? "-" : $F{tipoMeta}.name()]]></expression></element>
            <element kind="textField" x="455" y="2" width="75" height="16" pattern="#,##0.00" hTextAlign="Right" blankWhenNull="true"><expression><![CDATA[$F{valorMeta}]]></expression></element>
            <element kind="textField" x="530" y="2" width="85" height="16" pattern="#,##0.00" hTextAlign="Right" blankWhenNull="true"><expression><![CDATA[$F{valorRealizado}]]></expression></element>
            <element kind="textField" x="615" y="2" width="62" height="16" pattern="#,##0.00" hTextAlign="Right" blankWhenNull="true"><expression><![CDATA[$F{percentual}]]></expression></element>
            <element kind="textField" style="StatusStyle" x="677" y="2" width="125" height="16" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$F{status}]]></expression></element>
        </band>
    </detail>

    <pageFooter height="24">
        <element kind="textField" x="0" y="6" width="300" height="15">
            <expression><![CDATA["Emitido em: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></expression>
        </element>
        <element kind="textField" x="700" y="6" width="102" height="15" hTextAlign="Right">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>
</jasperReport>
