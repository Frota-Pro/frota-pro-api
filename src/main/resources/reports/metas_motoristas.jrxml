<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="Relatório - Metas dos Motoristas" language="java"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <style name="StatusStyle" mode="Opaque" forecolor="#991B1B" backcolor="#FEE2E2" bold="true">
        <conditionalStyle>
            <conditionExpression><![CDATA[Boolean.TRUE.equals($F{dentroMeta})]]></conditionExpression>
            <style mode="Opaque" forecolor="#166534" backcolor="#DCFCE7" bold="true"/>
        </conditionalStyle>
    </style>

    <parameter name="logoPath" class="java.lang.Object"/>
    <parameter name="periodoInicio" class="java.time.LocalDate"/>
    <parameter name="periodoFim" class="java.time.LocalDate"/>
    <parameter name="tipoMeta" class="java.lang.String"/>
    <parameter name="totalMotoristas" class="java.lang.Long"/>
    <parameter name="totalDentroMeta" class="java.lang.Long"/>
    <parameter name="totalForaMeta" class="java.lang.Long"/>

    <field name="codigoMotorista" class="java.lang.String"/>
    <field name="nomeMotorista" class="java.lang.String"/>
    <field name="meta" class="java.math.BigDecimal"/>
    <field name="realizado" class="java.math.BigDecimal"/>
    <field name="percentual" class="java.math.BigDecimal"/>
    <field name="unidade" class="java.lang.String"/>
    <field name="dentroMeta" class="java.lang.Boolean"/>
    <field name="status" class="java.lang.String"/>

    <title height="118">
        <element kind="image" x="10" y="5" width="120" height="50" onErrorType="Blank">
            <expression><![CDATA[$P{logoPath}]]></expression>
        </element>

        <element kind="staticText" x="140" y="6" width="520" height="20" fontSize="14" bold="true">
            <text><![CDATA[RELATÓRIO DE METAS DOS MOTORISTAS]]></text>
        </element>

        <element kind="textField" x="140" y="30" width="520" height="16">
            <expression><![CDATA["Período: " + $P{periodoInicio} + " até " + $P{periodoFim}]]></expression>
        </element>

        <element kind="textField" x="140" y="48" width="520" height="16">
            <expression><![CDATA["Tipo de meta: " + $P{tipoMeta}]]></expression>
        </element>

        <element kind="textField" x="640" y="12" width="180" height="16" hTextAlign="Right">
            <expression><![CDATA["Motoristas: " + $P{totalMotoristas}]]></expression>
        </element>

        <element kind="staticText" mode="Opaque" x="0" y="72" width="258" height="22" forecolor="#FFFFFF" backcolor="#334155" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[TOTAL MOTORISTAS]]></text>
        </element>
        <element kind="textField" mode="Opaque" x="0" y="94" width="258" height="20" forecolor="#111827" backcolor="#E5E7EB" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <expression><![CDATA[$P{totalMotoristas}]]></expression>
        </element>

        <element kind="staticText" mode="Opaque" x="272" y="72" width="258" height="22" forecolor="#FFFFFF" backcolor="#15803D" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[DENTRO DA META]]></text>
        </element>
        <element kind="textField" mode="Opaque" x="272" y="94" width="258" height="20" forecolor="#166534" backcolor="#DCFCE7" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <expression><![CDATA[$P{totalDentroMeta}]]></expression>
        </element>

        <element kind="staticText" mode="Opaque" x="544" y="72" width="258" height="22" forecolor="#FFFFFF" backcolor="#B91C1C" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[FORA DA META / SEM META]]></text>
        </element>
        <element kind="textField" mode="Opaque" x="544" y="94" width="258" height="20" forecolor="#991B1B" backcolor="#FEE2E2" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <expression><![CDATA[$P{totalForaMeta}]]></expression>
        </element>
    </title>

    <columnHeader height="24">
        <element kind="staticText" mode="Opaque" x="0" y="3" width="95" height="18" forecolor="#FFFFFF" backcolor="#334155" bold="true" hTextAlign="Center">
            <text><![CDATA[CÓDIGO]]></text>
        </element>
        <element kind="staticText" mode="Opaque" x="95" y="3" width="245" height="18" forecolor="#FFFFFF" backcolor="#334155" bold="true" hTextAlign="Center">
            <text><![CDATA[MOTORISTA]]></text>
        </element>
        <element kind="staticText" mode="Opaque" x="340" y="3" width="95" height="18" forecolor="#FFFFFF" backcolor="#334155" bold="true" hTextAlign="Center">
            <text><![CDATA[META]]></text>
        </element>
        <element kind="staticText" mode="Opaque" x="435" y="3" width="105" height="18" forecolor="#FFFFFF" backcolor="#334155" bold="true" hTextAlign="Center">
            <text><![CDATA[REALIZADO]]></text>
        </element>
        <element kind="staticText" mode="Opaque" x="540" y="3" width="80" height="18" forecolor="#FFFFFF" backcolor="#334155" bold="true" hTextAlign="Center">
            <text><![CDATA[%]]></text>
        </element>
        <element kind="staticText" mode="Opaque" x="620" y="3" width="80" height="18" forecolor="#FFFFFF" backcolor="#334155" bold="true" hTextAlign="Center">
            <text><![CDATA[UNIDADE]]></text>
        </element>
        <element kind="staticText" mode="Opaque" x="700" y="3" width="102" height="18" forecolor="#FFFFFF" backcolor="#334155" bold="true" hTextAlign="Center">
            <text><![CDATA[STATUS]]></text>
        </element>
    </columnHeader>

    <detail>
        <band height="18">
            <element kind="textField" x="0" y="1" width="95" height="15">
                <expression><![CDATA[$F{codigoMotorista}]]></expression>
            </element>
            <element kind="textField" x="95" y="1" width="245" height="15">
                <expression><![CDATA[$F{nomeMotorista}]]></expression>
            </element>
            <element kind="textField" x="340" y="1" width="95" height="15" pattern="#,##0.00" hTextAlign="Right" blankWhenNull="true">
                <expression><![CDATA[$F{meta}]]></expression>
            </element>
            <element kind="textField" x="435" y="1" width="105" height="15" pattern="#,##0.00" hTextAlign="Right">
                <expression><![CDATA[$F{realizado}]]></expression>
            </element>
            <element kind="textField" x="540" y="1" width="80" height="15" pattern="#,##0.00" hTextAlign="Right">
                <expression><![CDATA[$F{percentual}]]></expression>
            </element>
            <element kind="textField" x="620" y="1" width="80" height="15" hTextAlign="Center">
                <expression><![CDATA[$F{unidade}]]></expression>
            </element>
            <element kind="textField" style="StatusStyle" x="700" y="1" width="102" height="15" hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[$F{status}]]></expression>
            </element>
        </band>
    </detail>

    <pageFooter height="24">
        <element kind="textField" x="0" y="6" width="300" height="15">
            <expression><![CDATA["Emitido em: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></expression>
        </element>
        <element kind="textField" x="700" y="6" width="102" height="15" hTextAlign="Right">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>

</jasperReport>
